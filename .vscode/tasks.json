{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure",
            "type": "process",
            "command": "cmake",
            "args": [
                "--preset=rev5-debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}/targets/can-led"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Build",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset=rev5-debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}/targets/can-led"
            },
            "dependsOn": [
                "Configure"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Flash",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset=rev5-debug",
                "--target",
                "flash"
            ],
            "options": {
                "cwd": "${workspaceFolder}/targets/can-led"
            },
            "dependsOn": [
                "Configure"
            ],
            "problemMatcher": [],
            "group": "none"
        }
    ]
}
